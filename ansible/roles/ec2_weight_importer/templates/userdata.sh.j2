#!/bin/bash
# EC2 user-data: pull HF token from SSM, fetch the streaming script from S3, stream all
# weights HF -> S3, write a status marker + log back to S3, then self-terminate.
exec > >(tee /var/log/importer.log) 2>&1
set -x
REGION="{{ region }}"
BUCKET="{{ weights_bucket }}"
PREFIX="{{ imported_model_name }}"
REPO="{{ hf_repo_id }}"

export HF_TOKEN="$(aws ssm get-parameter --region "$REGION" --name '{{ importer_ssm_token_name }}' --with-decryption --query Parameter.Value --output text)"
aws s3 cp "s3://${BUCKET}/_importer/stream_hf_to_s3.sh" /tmp/stream.sh --region "$REGION"
chmod +x /tmp/stream.sh

if /tmp/stream.sh "$REPO" "$BUCKET" "$PREFIX" "$REGION"; then
  echo done | aws s3 cp - "s3://${BUCKET}/_importer/STATUS_DONE" --region "$REGION"
else
  echo failed | aws s3 cp - "s3://${BUCKET}/_importer/STATUS_FAILED" --region "$REGION"
fi
aws s3 cp /var/log/importer.log "s3://${BUCKET}/_importer/importer.log" --region "$REGION" || true
shutdown -h now
