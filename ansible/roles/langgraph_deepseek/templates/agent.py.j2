"""Minimal LangGraph agent wired to a Bedrock Custom-Imported DeepSeek model.

Auth is SigV4 via the `coaa` profile / IAM role, so traffic can traverse the
bedrock-runtime PrivateLink VPC endpoint and every call lands in CloudTrail —
that's the AWS-native data-governance story for line item 2.

The imported model is DeepSeek-R1-Distill-Llama-70B. Even though the architecture is
Llama, it uses DeepSeek's OWN chat template and is a *reasoning* model (it emits a
<think>...</think> block). So we call InvokeModel directly with the DeepSeek template
rather than letting a chat wrapper apply the Llama-3 template (which yields empty output),
and we strip the reasoning to get the final answer.

Prompting follows the DeepSeek-R1 model card: no system prompt (all instructions go in the
user turn), temperature 0.6 / top_p 0.95, and the assistant turn is prefilled with
"<think>\n" so the model always reasons before answering (otherwise it sometimes skips
reasoning and just echoes the prompt).
"""
import json
import os
import sys

import boto3
from langgraph.graph import END, START, StateGraph
from typing_extensions import TypedDict

REGION = os.environ.get("AWS_REGION", "{{ region }}")
MODEL_ARN = os.environ.get("IMPORTED_MODEL_ARN", "{{ imported_model_arn }}")
# R1 reasons at length even on trivial prompts; 512 tokens often truncates mid-<think>.
MAX_GEN_LEN = int(os.environ.get("MAX_GEN_LEN", "2048"))

client = boto3.Session(
    profile_name=os.environ.get("AWS_PROFILE", "{{ aws_profile }}"),
    region_name=REGION,
).client("bedrock-runtime")


def deepseek_prompt(user: str) -> str:
    # DeepSeek-R1-Distill chat template, no system prompt, reasoning block prefilled.
    return f"<｜begin▁of▁sentence｜><｜User｜>{user}<｜Assistant｜><think>\n"


class State(TypedDict):
    prompt: str
    answer: str
    raw: str


def call_model(state: State) -> State:
    body = {
        "prompt": deepseek_prompt(state["prompt"]),
        "max_gen_len": MAX_GEN_LEN,
        "temperature": 0.6,
        "top_p": 0.95,
    }
    resp = client.invoke_model(modelId=MODEL_ARN, body=json.dumps(body))
    out = json.loads(resp["body"].read())
    gen = out.get("generation", "")
    # The prompt opens the reasoning block, so the final answer follows the closing
    # </think>. No </think> means max_gen_len was hit mid-reasoning — return empty rather
    # than leaking the raw reasoning.
    answer = gen.rsplit("</think>", 1)[1].strip() if "</think>" in gen else ""
    return {"prompt": state["prompt"], "answer": answer, "raw": gen}


graph = StateGraph(State)
graph.add_node("model", call_model)
graph.add_edge(START, "model")
graph.add_edge("model", END)
app = graph.compile()


def main() -> int:
    smoke = "--smoke" in sys.argv
    prompt = (
        "What is 2+2? Give only the final number."
        if smoke
        else " ".join(a for a in sys.argv[1:] if not a.startswith("-")) or "Say hello."
    )
    result = app.invoke({"prompt": prompt, "answer": "", "raw": ""})
    if result["answer"]:
        print("ANSWER:", result["answer"])
    elif result["raw"].strip():
        print(f"ANSWER: (truncated during reasoning — hit MAX_GEN_LEN={MAX_GEN_LEN}; raise it)")
    else:
        print("ANSWER: (empty generation)")
    if smoke:
        # Success = the imported model produced a non-empty generation over SigV4/LangGraph.
        if not result["raw"].strip():
            print("SMOKE FAIL: empty generation", file=sys.stderr)
            return 1
        print("SMOKE OK: langgraph-deepseek-ok (imported DeepSeek reachable via LangGraph + SigV4)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
